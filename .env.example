# Atlas environment — copy to .env and fill secrets. .env is gitignored.
# No secrets are baked into the image.

# LLM — decoupled from agents API. Leave all keys empty to run with heuristic stub.
# Atlas starts and serves /ask and /brief with no provider. Plug one in later and restart.
# ATLAS_LLM_BACKEND=auto  → picks first key present (gemini → openai → anthropic), else stub
# Set explicitly to gemini|openai|anthropic|vllm|ollama|stub to force.
ATLAS_LLM_BACKEND=auto                # auto|stub|none|gemini|openai|anthropic|vllm|ollama
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VLLM_URL=http://vllm:8000
OLLAMA_HOST=http://ollama:11434
ATLAS_GEMINI_MODEL=gemini-2.0-flash
ATLAS_OPENAI_MODEL=gpt-4o-mini
ATLAS_ANTHROPIC_MODEL=claude-3-5-haiku-latest
ATLAS_OLLAMA_MODEL=qwen2.5:7b
ATLAS_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Research sources
S2_API_KEY=
ATLAS_S2_BASE=https://api.semanticscholar.org/graph/v1

# Topics: comma-separated topic:min_citations  (threshold before any LLM spend)
TOPICS=reranking:80,retrieval:50,rag:50,agents:50

# Bound — eviction policy (see PLAN.md §3). Tunable, echoed on /health
ATLAS_MAX_PAPERS=1500
ATLAS_MAX_CHUNKS=15000
ATLAS_MAX_BYTES_MB=2048
ATLAS_MIN_KEEP_DAYS=7
ATLAS_EVICTION=oldest_first            # oldest_first|citation_agnostic

# Vector
ATLAS_EMBED_MODEL=BAAI/bge-m3
ATLAS_RERANK_MODEL=BAAI/bge-reranker-v2-m3
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=atlas_papers

# Structured + cache
DATABASE_URL=postgresql+psycopg://atlas:atlas@postgres:5432/atlas
ATLAS_POSTGRES_PASSWORD=atlas
REDIS_URL=redis://redis:6379/0

# API
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=

# Observability
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=atlas
